{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
  "enabled_providers": ["openrouter"],
  "provider": {
    "openrouter": {
      "whitelist": ["deepseek/deepseek-v4.1-flash"],
      "models": {
        "deepseek/deepseek-v4.1-flash": { "options": { "provider": { "sort": "price" } } }
      }
    }
  },
  "mcp": {
    "plazos": {
      "type": "remote",
      "url": "PEGA_AQUI_LA_DIRECCION_DE_PRODUCCION_DE_TU_SERVIDOR_MCP",
      "enabled": true
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "plazos_*": "ask"
  }
}
