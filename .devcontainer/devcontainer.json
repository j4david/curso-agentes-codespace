{
  "name": "Agentes y automatización con IA",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "postStartCommand": "nohup bash .devcontainer/arrancar_opencode.sh > /dev/null 2>&1",
  "postAttachCommand": "nohup bash .devcontainer/arrancar_opencode.sh > /dev/null 2>&1",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": { "label": "OpenCode (web)", "onAutoForward": "notify" },
    "8092": { "label": "Modelo local (llama.cpp)", "onAutoForward": "silent" }
  },
  "secrets": {
    "GOOGLE_API_KEY": {
      "description": "Tu clave de Google AI Studio (Gemini). La usan los ejemplos 6 a 9 (LangGraph). Si prefieres OpenRouter, mira el paso 7 del README. Si la dejas en blanco, puedes ponerla después en un archivo .env.",
      "documentationUrl": "https://aistudio.google.com/apikey"
    }
  }
}
